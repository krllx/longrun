{
  "description": "Codex adapter for the common longrun CLI. Review these hooks in /hooks after installation.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LONGRUN_BIN hook --client codex SessionStart",
            "timeout": 20,
            "statusMessage": "longrun: loading notes"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LONGRUN_BIN hook --client codex UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LONGRUN_BIN hook --client codex PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LONGRUN_BIN hook --client codex PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LONGRUN_BIN hook --client codex PermissionRequest",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LONGRUN_BIN hook --client codex PreCompact",
            "timeout": 60
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LONGRUN_BIN hook --client codex PostCompact",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LONGRUN_BIN hook --client codex Stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LONGRUN_BIN hook --client codex SessionEnd",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LONGRUN_BIN hook --client codex Interrupt",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
